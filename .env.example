PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/animeverse.sqlite
REDIS_URL=
CATALOG_PROVIDER=kitsu
KITSU_BASE_URL=https://kitsu.io/api/edge
JIKAN_BASE_URL=https://api.jikan.moe/v4
PLAYBACK_PROVIDER=hianime
# URL base da sua instância HiAnime API (exemplo local; sem /api/v2 no fim).
HIANIME_API_BASE_URL=http://localhost:3030
HIANIME_API_TIMEOUT_MS=12000
# Alternativa legada. Para usá-la, selecione PLAYBACK_PROVIDER=consumet.
CONSUMET_ENABLED=false
CONSUMET_BASE_URL=http://localhost:3001
CONSUMET_ANIME_PROVIDER=gogoanime
CONSUMET_TIMEOUT_MS=12000
# Intervalo mínimo entre consultas quando o catálogo Jikan estiver selecionado.
JIKAN_MIN_INTERVAL_MS=350
CACHE_POPULAR_TTL_SECONDS=1800
CACHE_SEARCH_TTL_SECONDS=600
CACHE_DETAILS_TTL_SECONDS=21600
CACHE_EPISODES_TTL_SECONDS=3600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
